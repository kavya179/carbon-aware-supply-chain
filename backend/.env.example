# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/carbon_supply_chain

# Django Carbon Service
CARBON_SERVICE_URL=http://localhost:8001

# ─── JWT Configuration ────────────────────────────────────────────────
# Access token — short-lived (15 minutes)
JWT_ACCESS_SECRET=your-very-strong-access-token-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token — long-lived (7 days), stored as httpOnly cookie
JWT_REFRESH_SECRET=your-very-strong-refresh-token-secret-min-32-chars-different-from-access
JWT_REFRESH_EXPIRES_IN=7d

# Legacy: used as fallback if ACCESS/REFRESH secrets not set
JWT_SECRET=your-legacy-jwt-secret-change-in-production

# CORS Origin
CORS_ORIGIN=http://localhost:5173
